*.o
*.so

# Outputs written by the scripts at run time
sampler/output/
sampler/checks/output/
simulations/*/results/
simulations/*/quick_results/
simulations/*/figures/
simulations/scaling/processed/
simulations/scaling/summary/
simulations/scaling/logs/
applications/output/
applications/data/sunspots.csv
applications/data/bike.csv
# raw files downloaded by prep_sunspots.R and prep_bike.R (their SHA256SUMS.txt stay tracked)
applications/data/raw/sunspots/*
!applications/data/raw/sunspots/SHA256SUMS.txt
applications/data/raw/bike/*
!applications/data/raw/bike/SHA256SUMS.txt
